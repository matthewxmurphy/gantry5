{% extends "@gantry-admin/partials/base.html.twig" %}

{% block gantry %}
<section aria-labelledby="upgrade-assistant-heading">
    <h2 id="upgrade-assistant-heading">Upgrade assistant</h2>
    <p>Check this installation and protect the selected outline before changing Gantry or its theme.</p>
    <p><strong>Scope:</strong> {{ gantry.theme.name }} / {{ outline }}. Only this outline's YAML settings are included. CMS accounts, service configuration, PHP, theme assets and other outlines are excluded.</p>
    {% if upgrade %}
    <h3>Local compatibility preflight</h3>
    <dl>
        <dt>Gantry / theme</dt><dd>{{ upgrade.gantry }} / {{ upgrade.theme_version }}</dd>
        <dt>Theme declarations</dt><dd>{{ upgrade.theme_supported ? 'Current Gantry minimum and platform declarations pass.' : 'Declared dependencies need review; no upgrade compatibility is assumed.' }}</dd>
        <dt>CMS</dt><dd>{{ upgrade.cms }} {{ upgrade.cms_version }}</dd>
        <dt>PHP</dt><dd>{{ upgrade.php }}; declared requirement: {{ upgrade.php_constraint ?: 'unknown' }}.
            {{ upgrade.php_supported is same as(true) ? 'Within the declared range.' : 'Compatibility needs review.' }}</dd>
        <dt>Configured particle types</dt><dd>{% if not upgrade.particles_inspected %}No saved layout index is available for inspection.{% elseif upgrade.missing_particles %}Unavailable or incompatible: {{ upgrade.missing_particles|join(', ') }}{% else %}All indexed types are available under current platform dependency checks.{% endif %}</dd>
        <dt>Outline configuration</dt><dd>{{ upgrade.snapshot_files }} YAML files readable and valid for snapshot preview.</dd>
    </dl>
    <p>This checks local declarations and configuration only. It does not certify third-party code, a future release or the rendered site.</p>
    {% endif %}
    {% if restore_result %}
    <div role="status"><strong>Outline restored.</strong> {{ restore_result.restored }} files restored; {{ restore_result.preserved }} unlisted files preserved. Gantry's theme cache was cleared.</div>
    <p>Review the site and recompile CSS using the existing Styles controls before continuing an upgrade.</p>
    {% endif %}
    {% if upgrade is defined and not upgrade.has_overrides %}
    <p role="status">No saved custom settings for this outline yet. Compatibility checks are available, but there is no custom configuration directory to snapshot or restore. Save outline settings first.</p>
    {% else %}
    <h3>Download a private snapshot</h3>
    <p>The snapshot preserves exact YAML bytes, including particle content and any embedded credentials. Store it privately. It is not a complete site backup.</p>
    <form method="post" action="{{ gantry.route('configurations', outline, 'upgrade', 'download') }}">
        <input type="hidden" name="g6_revision" value="{{ g6_revision }}">
        <label><input type="checkbox" name="private_ack" value="yes" required> I understand this may contain private content or embedded credentials and will store it securely.</label>
        <p><button class="button button-primary" type="submit">Download private outline snapshot</button></p>
    </form>
    <h3>Preview a restore</h3>
    <p>Choose a snapshot from this CMS, theme and outline. Preview does not change configuration. Maximum upload: {{ snapshot_limit }} bytes.</p>
    <form method="post" enctype="multipart/form-data" action="{{ gantry.route('configurations', outline, 'upgrade', 'preview') }}">
        <input type="hidden" name="g6_revision" value="{{ g6_revision }}">
        <label for="upgrade-preview-file">Private snapshot JSON</label>
        <input id="upgrade-preview-file" type="file" name="snapshot" accept="application/json,.json" required>
        <p><button class="button" type="submit">Preview restore</button></p>
    </form>
    {% if restore_preview %}
    <h3>Restore preview</h3>
    <p>{{ restore_preview.changes }} files would change. {{ restore_preview.preserved }} unlisted files will be preserved. Values are not displayed.</p>
    <table><caption>Selected outline file changes</caption><thead><tr><th scope="col">Relative path</th><th scope="col">Action</th></tr></thead><tbody>
    {% for file in restore_preview.files %}<tr><td>{{ file.path }}</td><td>{{ file.action }}</td></tr>{% endfor %}
    </tbody></table>
    <form method="post" enctype="multipart/form-data" action="{{ gantry.route('configurations', outline, 'upgrade', 'restore') }}">
        <input type="hidden" name="g6_revision" value="{{ g6_revision }}">
        <input type="hidden" name="revision" value="{{ restore_preview.revision }}">
        <input type="hidden" name="snapshot_digest" value="{{ restore_preview.snapshot }}">
        <p>Close other configuration editors. Choose the same snapshot again; browsers do not retain uploaded files after preview.</p>
        <label for="upgrade-restore-file">Same private snapshot JSON</label>
        <input id="upgrade-restore-file" type="file" name="snapshot" accept="application/json,.json" required>
        <p><label><input type="checkbox" name="restore_confirm" value="yes" required> Restore the listed files now, preserving unlisted files.</label></p>
        <button class="button button-primary" type="submit">Restore selected outline</button>
    </form>
    {% endif %}
    {% endif %}
</section>
{% endblock %}
