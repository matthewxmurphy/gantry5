{% extends "@gantry-admin/partials/base.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ url('gantry-admin://assets/js/swagger-ui/swagger-ui.css') }}">
    <style>
        #gantry-api-docs { background: #fff; color: #20242a; padding: 1rem; overflow-wrap: anywhere; }
        #gantry-api-docs .swagger-ui { max-width: 100%; }
        #gantry-api-docs .swagger-ui input { color: #20242a; }
        #gantry-api-docs .swagger-ui .opblock-summary-control,
        #gantry-api-docs .swagger-ui .opblock-summary-path-description-wrapper { min-width: 0; }
        #gantry-api-docs .swagger-ui .opblock-summary-path { min-width: 0; overflow-wrap: anywhere; }
        #gantry-api-docs .swagger-ui .opblock-summary-path span { overflow-wrap: anywhere; }
        #gantry-api-docs .swagger-ui .info .title small { padding: 2px 6px; line-height: 1.4; vertical-align: middle; }
        #gantry-api-docs .swagger-ui .info .title small pre { padding: 0; margin: 0; font-size: 12px; line-height: 1.4; }
        #gantry-api-docs .swagger-ui .responses-inner { overflow-x: auto; }
        #gantry-api-docs a:focus-visible, #gantry-api-docs button:focus-visible { outline: 3px solid #1769aa; outline-offset: 3px; }
        @media (max-width: 600px) {
            #gantry-api-docs { padding: 0.5rem; }
            #gantry-api-docs .swagger-ui .opblock-summary-control { flex-wrap: wrap; }
            #gantry-api-docs .swagger-ui .opblock-summary-path-description-wrapper { flex: 1 1 100%; }
            #gantry-api-docs .swagger-ui .opblock-summary-path,
            #gantry-api-docs .swagger-ui .opblock-summary-path a,
            #gantry-api-docs .swagger-ui .opblock-summary-path span { white-space: normal; max-width: 100%; }
            #gantry-api-docs .swagger-ui .opblock-summary-description { min-width: 0; max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
        }
    </style>
{% endblock %}

{% block javascript %}
    {{ parent() }}
    <script defer src="{{ url('gantry-admin://assets/js/swagger-ui/swagger-ui-bundle.js') }}"></script>
    <script defer src="{{ url('gantry-admin://js/api-docs.js') }}"></script>
{% endblock %}

{% block gantry %}
    <div id="gantry-api-docs" data-api-available="{{ api_available ? 'yes' : 'no' }}">
        <h1>API / Swagger</h1>
        {% if api_available %}
            <p>Gantry 6 core API uses Joomla Web Services and your existing Joomla API token. Select Authorize and enter that token to try a request. Your token remains in this page's memory and is cleared on reload.</p>
        {% else %}
            <p>This release exposes the API through Joomla 6.2 Web Services. The contract is available here as a reference; this CMS has no API transport in Gantry 6.0.3.</p>
        {% endif %}
        <p><a href="{{ gantry.route('api', 'openapi') }}" target="_blank" rel="noopener">OpenAPI JSON (new tab)</a>. Updates and deletes require the current resource revision from its GET response. New outlines are unassigned.</p>
        <div id="gantry-swagger-ui" aria-label="Gantry API operations"></div>
        <script type="application/json" id="gantry-openapi-spec">{{ api_spec_json|raw }}</script>
        <noscript>Enable JavaScript to use Swagger UI, or open the OpenAPI JSON link.</noscript>
        {% if api_available %}
            {% include '@gantry-admin/pages/api-extension-inventory.html.twig' %}
        {% endif %}
    </div>
{% endblock %}
