{
    "name": "gantry/joomla",
    "description": "Gantry Framework Library",
    "license": "GPLv2",

    "require": {
        "php": ">=8.5.0 <8.6.0",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-dom": "*",
        "ext-xml": "*",
        "ext-simplexml": "*",
        "symfony/event-dispatcher": "7.4.17",
        "symfony/yaml": "7.4.22",
        "pimple/pimple": "^3.5",
        "filp/whoops": "^2.15.2",
        "rockettheme/toolbox": "2.0.1",
        "erusev/parsedown-extra": "^0.8.0",
        
        "twig/twig": "3.30.0",
        "matthiasmullie/minify": "1.3.75",
        "scssphp/scssphp": "^1.11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Gantry\\": "src/classes/Gantry"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        }
    }
